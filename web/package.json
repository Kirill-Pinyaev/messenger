{
  "name": "web",
  "version": "1.0.0",
  "description": "grpc-web client for messenger",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen && vite build",
    "gen": "mkdir -p ./src/gen && /tmp/protoc29/bin/protoc --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --plugin=protoc-gen-connect-es=./node_modules/.bin/protoc-gen-connect-es -I /tmp/protoc29/include -I ../api/proto --es_out=target=js:./src/gen --connect-es_out=target=js:./src/gen ../api/proto/messenger/v1/messenger.proto",
    "preview": "vite preview"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.1",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-web": "^1.7.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^1.10.1",
    "@connectrpc/protoc-gen-connect-es": "^1.7.0",
    "vite": "^8.0.9"
  }
}
